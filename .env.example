# Copy to .env for local development. Never commit real values (see /rules/git.md).
DATABASE_URL=postgresql://advocateid:advocateid@localhost:5432/advocateid
# Public origin of the main site (no trailing slash)
SITE_ORIGIN=http://localhost:3000
# Base hostname used for premium CNAME targets: {slug}.p.<ROOT_DOMAIN>
ROOT_DOMAIN=advocateid.in
# 32+ random characters; used to hash mobiles/IPs for lookups and to sign tokens
APP_SECRET=change-me-change-me-change-me-change-me
# SMS: "console" (dev only; prints nothing identifying), or "msg91"
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Image storage: "local" (dev) or "firebase"
STORAGE_PROVIDER=local
STORAGE_PUBLIC_BASE=/uploads
FIREBASE_BUCKET=
# Comma-separated mobiles (E.164, e.g. +919000000000) allowed into /admin
ADMIN_MOBILES=
# Shared secret for POST /api/jobs/nightly (called by a Kubernetes CronJob)
JOB_TOKEN=
