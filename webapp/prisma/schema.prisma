generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum LocationType {
  locality
  town
  city
  district
  state
}

enum ProfileType {
  free
  professional
}

enum InstitutionType {
  court
  tribunal
  legal_body
}

enum OutcomeTag {
  favorable
  unfavorable
  settled
  pending
}

model Locality {
  id           Int          @id @default(autoincrement())
  name         String
  localName    String?      @map("local_name")
  latitude     Decimal      @db.Decimal(10, 7)
  longitude    Decimal      @db.Decimal(10, 7)
  parentId     Int?         @map("parent_id")
  parent       Locality?    @relation("LocalityHierarchy", fields: [parentId], references: [id])
  children     Locality[]   @relation("LocalityHierarchy")
  locationType LocationType @map("location_type")
  slug         String       @unique
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")
  deletedBy    String?      @map("deleted_by")

  profiles     Profile[]
  offices      Office[]
  institutions Institution[]

  @@map("localities")
}

model Vertical {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  categories Category[]
  profiles   Profile[]

  @@map("verticals")
}

model Category {
  id         Int      @id @default(autoincrement())
  verticalId Int      @map("vertical_id")
  vertical   Vertical @relation(fields: [verticalId], references: [id])
  name       String
  slug       String   @unique

  profileCategories ProfileCategory[]

  @@map("categories")
}

model Profile {
  id                 Int         @id @default(autoincrement())
  verticalId         Int         @map("vertical_id")
  vertical           Vertical    @relation(fields: [verticalId], references: [id])
  profileType        ProfileType @map("profile_type")
  name               String
  slug               String      @unique
  tagline            String?
  bio                String      @db.Text
  photoUrl           String      @map("photo_url")
  whatsappNumber     String      @map("whatsapp_number")
  contactHours       String?     @map("contact_hours")
  primaryLocalityId  Int         @map("primary_locality_id")
  primaryLocality    Locality    @relation(fields: [primaryLocalityId], references: [id])
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  deletedAt          DateTime?   @map("deleted_at")
  deletedBy          String?     @map("deleted_by")

  profileCategories    ProfileCategory[]
  offices              Office[]
  profileInstitutions  ProfileInstitution[]
  posts                Post[]
  caseSummaries        CaseSummary[]
  reviews              Review[]

  @@map("profiles")
}

model ProfileCategory {
  profileId  Int      @map("profile_id")
  profile    Profile  @relation(fields: [profileId], references: [id])
  categoryId Int      @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([profileId, categoryId])
  @@map("profile_categories")
}

model Office {
  id         Int       @id @default(autoincrement())
  profileId  Int       @map("profile_id")
  profile    Profile   @relation(fields: [profileId], references: [id])
  name       String?
  address    String    @db.Text
  localityId Int       @map("locality_id")
  locality   Locality  @relation(fields: [localityId], references: [id])
  latitude   Decimal   @db.Decimal(10, 7)
  longitude  Decimal   @db.Decimal(10, 7)
  isPrimary  Boolean   @default(false) @map("is_primary")
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")

  @@map("offices")
}

model Institution {
  id          Int              @id @default(autoincrement())
  type        InstitutionType
  name        String
  slug        String           @unique
  localityId  Int              @map("locality_id")
  locality    Locality         @relation(fields: [localityId], references: [id])
  latitude    Decimal          @db.Decimal(10, 7)
  longitude   Decimal          @db.Decimal(10, 7)
  description String?          @db.Text
  deletedAt   DateTime?        @map("deleted_at")
  deletedBy   String?          @map("deleted_by")

  profileInstitutions ProfileInstitution[]

  @@map("institutions")
}

model ProfileInstitution {
  profileId     Int         @map("profile_id")
  profile       Profile     @relation(fields: [profileId], references: [id])
  institutionId Int         @map("institution_id")
  institution   Institution @relation(fields: [institutionId], references: [id])

  @@id([profileId, institutionId])
  @@map("profile_institutions")
}

model Post {
  id             Int       @id @default(autoincrement())
  profileId      Int       @map("profile_id")
  profile        Profile   @relation(fields: [profileId], references: [id])
  title          String
  slug           String    @unique
  excerpt        String?
  body           String    @db.Text
  coverImageUrl  String?   @map("cover_image_url")
  publishedAt    DateTime  @map("published_at")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by")

  @@map("posts")
}

model CaseSummary {
  id             Int        @id @default(autoincrement())
  profileId      Int        @map("profile_id")
  profile        Profile    @relation(fields: [profileId], references: [id])
  title          String
  outcomeTag     OutcomeTag @map("outcome_tag")
  summary        String     @db.Text
  referenceLink  String?    @map("reference_link")
  deletedAt      DateTime?  @map("deleted_at")
  deletedBy      String?    @map("deleted_by")

  @@map("case_summaries")
}

model Review {
  id            Int       @id @default(autoincrement())
  profileId     Int       @map("profile_id")
  profile       Profile   @relation(fields: [profileId], references: [id])
  reviewerName  String    @map("reviewer_name")
  rating        Int       @db.TinyInt
  comment       String    @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")
  deletedBy     String?   @map("deleted_by")

  @@map("reviews")
}
