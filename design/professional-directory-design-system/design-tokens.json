{
  "version": "1.0",
  "metadata": {
    "name": "Professional Directory SaaS — Design System",
    "description": "Complete design tokens for the lawyer, CA and tax-professional directory. Derived from the Modernist design system as built in the approved mockups; per-vertical accents are the tenant customization layer.",
    "lastUpdated": "2026-09-14",
    "source": "Modernist_modern (_ds/modernist-*/styles.css) — the built mockups are the source of truth",
    "note": "Radius is 0 and the type family is Archivo by design-system rule. Do not substitute Inter or reintroduce corner radius; see specifications/deviations-from-brief.md."
  },
  "colors": {
    "ground": {
      "bg": "#F3F2F2",
      "surface": "#EAE9E9",
      "text": "#201E1D",
      "divider": "rgba(32,30,29,0.4)",
      "white": "#FFFFFF"
    },
    "platform": {
      "primary": "#EC3013",
      "primaryDark": "#DD2B0F",
      "primaryText": "#AE1800",
      "primaryLight": "#FFC4B8",
      "note": "Platform red. Used for platform chrome, the primary action and the poster statement. For paragraph-size text on the light ground use primaryText (#AE1800) — #EC3013 alone is 3:1, chrome-only."
    },
    "verticals": {
      "lawyer": {
        "primary": "#0066CC",
        "primaryDark": "#004499",
        "primaryLight": "#66B3FF",
        "secondary": "#004499",
        "accent": "#66B3FF",
        "textOnGround": "#004499"
      },
      "ca": {
        "primary": "#2D7C4A",
        "primaryDark": "#1F4A2C",
        "primaryLight": "#5ABA77",
        "secondary": "#1F4A2C",
        "accent": "#5ABA77",
        "textOnGround": "#1F4A2C"
      },
      "taxExpert": {
        "primary": "#E67E22",
        "primaryDark": "#D35400",
        "primaryLight": "#F39C12",
        "secondary": "#D35400",
        "accent": "#F39C12",
        "textOnGround": "#A2490A"
      }
    },
    "tenantPresets": {
      "note": "Offered to Professional and Premium tenants as a curated set. Free tier cannot customize.",
      "inkNavy": "#16233F",
      "platformRed": "#EC3013",
      "directoryBlue": "#0066CC",
      "forest": "#2D7C4A",
      "ochre": "#E67E22"
    },
    "ramps": {
      "neutral": {
        "100": "#F8F4F4",
        "200": "#EAE7E7",
        "300": "#D7D3D3",
        "400": "#BAB6B6",
        "500": "#9B9797",
        "600": "#7D7979",
        "700": "#605D5D",
        "800": "#444141",
        "900": "#2D2B2B"
      },
      "accent": {
        "100": "#FFF2EF",
        "200": "#FFE0D9",
        "300": "#FFC4B8",
        "400": "#FF9783",
        "500": "#FF563C",
        "600": "#DD2B0F",
        "700": "#AE1800",
        "800": "#7C1405",
        "900": "#4D170E"
      }
    },
    "semantic": {
      "success": "#27AE60",
      "warning": "#F39C12",
      "error": "#E74C3C",
      "info": "#3498DB",
      "star": "#EC3013",
      "note": "Star rating uses the active brand colour, not amber — the mockups set stars in the accent so the rating reads as part of the tenant's identity."
    }
  },
  "typography": {
    "fontFamilies": {
      "headings": "\"Archivo\", system-ui, sans-serif",
      "body": "\"Archivo\", system-ui, sans-serif",
      "mono": "\"Monaco\", \"Courier New\", monospace"
    },
    "fontSizes": {
      "display": {
        "mobile": "36px",
        "tablet": "56px",
        "desktop": "78px"
      },
      "h1": {
        "mobile": "30px",
        "tablet": "44px",
        "desktop": "56px"
      },
      "h2": {
        "mobile": "24px",
        "tablet": "32px",
        "desktop": "38px"
      },
      "h3": {
        "mobile": "15px",
        "tablet": "16px",
        "desktop": "16px"
      },
      "bodyLarge": {
        "mobile": "15px",
        "tablet": "16px",
        "desktop": "16px"
      },
      "body": {
        "mobile": "14px",
        "tablet": "14px",
        "desktop": "15px"
      },
      "small": {
        "mobile": "13px",
        "tablet": "13px",
        "desktop": "13px"
      },
      "micro": {
        "mobile": "12px",
        "tablet": "12px",
        "desktop": "12px"
      },
      "kicker": {
        "mobile": "10px",
        "tablet": "10px",
        "desktop": "10px"
      }
    },
    "fontWeights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "black": 800
    },
    "lineHeights": {
      "display": 0.98,
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.65,
      "loose": 1.8
    },
    "letterSpacing": {
      "display": "-0.04em",
      "tight": "-0.02em",
      "normal": "0",
      "kicker": "0.14em",
      "wider": "0.16em"
    },
    "rules": [
      "Headings are weight 800 with negative tracking; display sizes go to -0.04em.",
      "Kickers are 10px/600 uppercase at 0.14em tracking in neutral-700 — the system's only uppercase label.",
      "Everything is flush left. Never centre a heading, a paragraph or a button label.",
      "Minimum body size is 13px; 12px is reserved for metadata."
    ]
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "xxl": "48px"
  },
  "borderRadius": {
    "none": "0px",
    "sm": "0px",
    "md": "0px",
    "lg": "0px",
    "xl": "0px",
    "full": "0px",
    "note": "Zero radius is a binding rule of the Modernist system. The 'full' pill token is deliberately 0 — tags and badges are square."
  },
  "borders": {
    "hairline": "1px solid #D7D3D3",
    "rule": "2px solid #201E1D",
    "tenantRule": "2px solid var(--brand)",
    "note": "2px rules between major sections; 1px hairlines inside a section. Never soften a 2px rule to a hairline."
  },
  "shadows": {
    "none": "none",
    "sm": "0 1px 2px rgba(45,43,43,0.14)",
    "md": "0 3px 10px rgba(45,43,43,0.16)",
    "lg": "0 12px 32px rgba(45,43,43,0.22)"
  },
  "breakpoints": {
    "mobile": "375px",
    "tablet": "768px",
    "desktop": "1200px",
    "wide": "1600px"
  },
  "layout": {
    "containerMaxWidth": "1200px",
    "contentPadding": {
      "mobile": "18px",
      "tablet": "24px",
      "desktop": "36px"
    },
    "sectionSpacing": {
      "mobile": "20px",
      "tablet": "24px",
      "desktop": "26px"
    },
    "measureMax": "720px"
  },
  "imagery": {
    "portraitAspect": "4 / 5",
    "portraitBackground": "#FFFFFF",
    "note": "Every professional portrait is 4:5 on a white ground, mobile and desktop alike. Tenants are asked to upload a white-background photo so it sits flush against coloured fields."
  },
  "touchTargets": {
    "minMobile": "44px",
    "minDesktop": "40px",
    "primaryActionHeight": "48px",
    "icon": "24px"
  }
}